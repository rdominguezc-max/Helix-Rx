BOOTSTRAP_PATIENT_ID=
BOOTSTRAP_USER_ID=
BOOTSTRAP_RELATIONSHIP_TYPE=organization_admin_viewer
BOOTSTRAP_CONSENT_TYPE=patient_data_access
BOOTSTRAP_CONSENT_SCOPES=patients.read,patients.write
